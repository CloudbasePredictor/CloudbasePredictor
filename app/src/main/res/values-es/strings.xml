    <!-- Help dialog - Thermic -->
    <string name="help_thermic_title">Ayuda del pronóstico térmico</string>
    <string name="help_thermic_summary">El color muestra la corriente ascendente estimada del aire en m/s, no el ascenso neto del parapente. La escala va del azul pálido al rojo pasando por el verde.</string>
    <string name="help_thermic_model_blocks_info">Los cuadrados de color son intervalos de tiempo y altitud; los rojos sólidos marcan el límite superior de la escala de ascendencia.</string>
    <string name="help_thermic_cursor_info">Toca una celda para ver la hora, la altitud, el rango de ascendencia, la capa de nubes, la confianza y los diagnósticos del modelo.</string>
    <string name="help_thermic_dashed_lines_title">Líneas, bandas y diagnósticos:</string>
    <string name="help_thermic_dry_top_line">Trama naranja: incertidumbre de la cima térmica</string>
    <string name="help_thermic_cloud_base_line">Área azul translúcida: posible capa de nubes, no ascendencia seca</string>
    <string name="help_thermic_moist_top_line">Morado: cima húmeda/de nubes</string>
    <string name="help_thermic_pressure_levels_line">Gris discontinuo: niveles de presión sin procesar</string>

    <!-- Help dialog - Skew-T -->
    <string name="help_stuve_title">Diagrama Skew-T log-P</string>
    <string name="help_stuve_summary">Sondeo vertical para una hora del pronóstico. La mayor altitud está arriba; la presión disminuye hacia arriba.</string>
    <string name="help_stuve_lines_title">Líneas:</string>
    <string name="help_stuve_temperature_line">Rojo: temperatura del aire</string>
    <string name="help_stuve_dewpoint_line">Azul: punto de rocío</string>
    <string name="help_stuve_parcel_line">Gris discontinuo: trayectoria por defecto de la parcela</string>
    <string name="help_stuve_active_parcel_line">Verde: trayectoria de la parcela según tu toque o cambio de calentamiento</string>
    <string name="help_stuve_ccl_line">Marrón discontinuo: base estimada de los cúmulos (CCL)</string>
    <string name="help_stuve_reference_grid">Las líneas de cuadrícula verde pálido, turquesa y azul son adiabáticas secas, adiabáticas húmedas y líneas de relación de mezcla. La franja derecha marca las capas húmedas.</string>
    <string name="help_stuve_controls_title">Controles:</string>
    <string name="help_stuve_control_hour">Control deslizante de tiempo: cambia la hora del pronóstico.</string>
    <string name="help_stuve_control_cursor">Toca o arrastra el gráfico: lee la temperatura, el punto de rocío, la parcela, el viento, la presión y la altitud en un nivel.</string>
    <string name="help_stuve_control_heating_zoom">Arrastra el control verde inferior para cambiar la temperatura inicial de la parcela. Pellizca para hacer zoom en la altitud.</string>

    <!-- Help dialog - Wind -->
    <string name="help_wind_title">Ayuda del pronóstico de viento</string>
    <string name="help_wind_summary">Los colores de la velocidad del viento van del azul al rojo pasando por el verde; el rojo marca el máximo de la escala (km/h):</string>
    <string name="help_wind_moisture_title">Indicadores de humedad:</string>
    <string name="help_wind_ccl_line">Línea CCL naranja: base estimada de los cúmulos cuando el calentamiento es suficiente.</string>

    <!-- Help dialog - Cloud -->
