    <!-- Help dialog - Thermic -->
    <string name="help_thermic_title">Справка по прогнозу термичности</string>
    <string name="help_thermic_summary">Цвет показывает оценочный восходящий поток воздуха в м/с, а не чистый набор высоты параплана. Шкала идёт от бледно-голубого через зелёный к красному.</string>
    <string name="help_thermic_model_blocks_info">Цветные квадраты — это ячейки «время — высота»; сплошной красный цвет отмечает верхнюю границу шкалы потока.</string>
    <string name="help_thermic_cursor_info">Нажмите на ячейку, чтобы увидеть время, высоту, диапазон подъёма, слой облаков, достоверность и диагностику модели.</string>
    <string name="help_thermic_dashed_lines_title">Линии, полосы и диагностика:</string>
    <string name="help_thermic_dry_top_line">Оранжевая штриховка — неопределённость вершины термика</string>
    <string name="help_thermic_cloud_base_line">Полупрозрачная синяя область — возможный слой облаков, а не сухой поток</string>
    <string name="help_thermic_moist_top_line">Фиолетовый — влажная/облачная вершина</string>
    <string name="help_thermic_pressure_levels_line">Серый пунктир — исходные уровни давления</string>

    <!-- Help dialog - Skew-T -->
    <string name="help_stuve_title">Диаграмма Skew-T log-P</string>
    <string name="help_stuve_summary">Вертикальное зондирование для одного часа прогноза. Большая высота — вверху; давление уменьшается кверху.</string>
    <string name="help_stuve_lines_title">Линии:</string>
    <string name="help_stuve_temperature_line">Красный — температура воздуха</string>
    <string name="help_stuve_dewpoint_line">Синий — точка росы</string>
    <string name="help_stuve_parcel_line">Серый пунктир — путь частицы по умолчанию</string>
    <string name="help_stuve_active_parcel_line">Зелёный — путь частицы по вашему нажатию или изменению нагрева</string>
    <string name="help_stuve_ccl_line">Коричневый пунктир — оценочная база кучевых облаков (CCL)</string>
    <string name="help_stuve_reference_grid">Бледно-зелёные, бирюзовые и синие линии сетки — это сухие адиабаты, влажные адиабаты и линии отношения смеси. Правая полоса отмечает влажные слои.</string>
    <string name="help_stuve_controls_title">Управление:</string>
    <string name="help_stuve_control_hour">Ползунок времени — переключение часа прогноза.</string>
    <string name="help_stuve_control_cursor">Нажмите или проведите по графику — узнайте температуру, точку росы, частицу, ветер, давление и высоту на уровне.</string>
    <string name="help_stuve_control_heating_zoom">Перетащите зелёный нижний маркер, чтобы изменить начальную температуру частицы. Сведите пальцы для масштабирования по высоте.</string>

    <!-- Help dialog - Wind -->
    <string name="help_wind_title">Справка по прогнозу ветра</string>
    <string name="help_wind_summary">Цвета скорости ветра идут от синего через зелёный к красному; красный отмечает максимум шкалы (км/ч):</string>
    <string name="help_wind_moisture_title">Признаки влажности:</string>
    <string name="help_wind_ccl_line">Оранжевая линия CCL — оценочная база кучевых облаков при достаточном прогреве.</string>

    <!-- Help dialog - Cloud -->
    <string name="help_cloud_title">Справка по прогнозу облачности</string>
    <string name="help_cloud_summary">Облачность и солнечная энергия у земли.</string>
    <string name="help_cloud_legend_sun">Часы солнца — прямой солнечный свет, достигающий земли.</string>
    <string name="help_cloud_legend_radiation">W/m² — солнечная энергия у земли; основной триггер термиков.</string>
    <string name="help_cloud_legend_layers" formatted="false">High / Mid / Low — покрытие неба по слоям, а не толщина облаков.</string>
    <string name="help_cloud_legend_rain" formatted="false">Rain — вероятность и количество.</string>

