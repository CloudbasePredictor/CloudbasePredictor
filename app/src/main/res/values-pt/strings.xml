    <!-- Help dialog - Thermic -->
    <string name="help_thermic_title">Ajuda da previsão térmica</string>
    <string name="help_thermic_summary">A cor mostra a ascendência de ar estimada em m/s, não a subida líquida do parapente. A escala vai do azul claro ao verde e ao vermelho.</string>
    <string name="help_thermic_model_blocks_info">Os quadrados coloridos são células de tempo-altitude; as cores vermelhas sólidas marcam o limite superior da escala de ascendência.</string>
    <string name="help_thermic_cursor_info">Toque numa célula para ver a hora, a altitude, o intervalo de ascendência, a camada de nuvens, a confiança e os diagnósticos do modelo.</string>
    <string name="help_thermic_dashed_lines_title">Linhas, faixas e diagnósticos:</string>
    <string name="help_thermic_dry_top_line">Tracejado laranja – incerteza do topo térmico</string>
    <string name="help_thermic_cloud_base_line">Área azul translúcida – possível camada de nuvens, não ascendência seca</string>
    <string name="help_thermic_moist_top_line">Roxo – topo húmido/de nuvens</string>
    <string name="help_thermic_pressure_levels_line">Tracejado cinzento – níveis de pressão brutos</string>

    <!-- Help dialog - Skew-T -->
    <string name="help_stuve_title">Diagrama Skew-T log-P</string>
    <string name="help_stuve_summary">Sondagem vertical para uma hora de previsão. A altitude aumenta para cima; a pressão diminui para cima.</string>
    <string name="help_stuve_lines_title">Linhas:</string>
    <string name="help_stuve_temperature_line">Vermelho – temperatura do ar</string>
    <string name="help_stuve_dewpoint_line">Azul – ponto de orvalho</string>
    <string name="help_stuve_parcel_line">Tracejado cinzento – trajetória da parcela predefinida</string>
    <string name="help_stuve_active_parcel_line">Verde – trajetória da parcela a partir do seu toque ou de uma alteração do aquecimento</string>
    <string name="help_stuve_ccl_line">Tracejado castanho – base estimada dos cúmulos (CCL)</string>
    <string name="help_stuve_reference_grid">As linhas da grelha verde-claras, turquesa e azuis são adiabáticas secas, adiabáticas húmidas e linhas de razão de mistura. A faixa direita marca as camadas húmidas.</string>
    <string name="help_stuve_controls_title">Controlos:</string>
    <string name="help_stuve_control_hour">Cursor de tempo – mude a hora de previsão.</string>
    <string name="help_stuve_control_cursor">Toque ou arraste no gráfico – leia a temperatura, o ponto de orvalho, a parcela, o vento, a pressão e a altitude num nível.</string>
    <string name="help_stuve_control_heating_zoom">Arraste a pega verde inferior para alterar a temperatura inicial da parcela. Faça o gesto de pinça para ampliar a altitude.</string>

    <!-- Help dialog - Wind -->
    <string name="help_wind_title">Ajuda da previsão de vento</string>
    <string name="help_wind_summary">As cores da velocidade do vento vão do azul ao verde e ao vermelho; o vermelho marca o máximo da escala (km/h):</string>
    <string name="help_wind_moisture_title">Indicações de humidade:</string>
    <string name="help_wind_ccl_line">Linha CCL laranja – base estimada dos cúmulos quando o aquecimento é suficiente.</string>

    <!-- Help dialog - Cloud -->
