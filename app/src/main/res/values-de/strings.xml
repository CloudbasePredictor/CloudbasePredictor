    <!-- Help dialog - Thermic -->
    <string name="help_thermic_title">Hilfe zur Thermikvorhersage</string>
    <string name="help_thermic_summary">Die Farbe zeigt das geschätzte Steigen der Luft in m/s, nicht das Netto-Steigen des Schirms. Die Skala reicht von blassblau über grün bis rot.</string>
    <string name="help_thermic_model_blocks_info">Farbige Quadrate sind Zeit-Höhen-Felder; rote Vollfarben markieren die Obergrenze der Steigskala.</string>
    <string name="help_thermic_cursor_info">Tippe auf eine Zelle für Zeit, Höhe, Steigbereich, Wolkenschicht, Konfidenz und Modelldiagnose.</string>
    <string name="help_thermic_dashed_lines_title">Linien, Bänder und Diagnose:</string>
    <string name="help_thermic_dry_top_line">Orange Schraffur – Unsicherheit der Thermikobergrenze</string>
    <string name="help_thermic_cloud_base_line">Blaue durchscheinende Fläche – mögliche Wolkenschicht, kein trockenes Steigen</string>
    <string name="help_thermic_moist_top_line">Violett – feuchte/Wolkenobergrenze</string>
    <string name="help_thermic_pressure_levels_line">Grau gestrichelt – rohe Druckniveaus</string>

    <!-- Help dialog - Skew-T -->
    <string name="help_stuve_title">Skew-T-log-P-Diagramm</string>
    <string name="help_stuve_summary">Vertikale Sondierung für eine Vorhersagestunde. Größere Höhe ist oben; der Druck nimmt nach oben ab.</string>
    <string name="help_stuve_lines_title">Linien:</string>
    <string name="help_stuve_temperature_line">Rot – Lufttemperatur</string>
    <string name="help_stuve_dewpoint_line">Blau – Taupunkt</string>
    <string name="help_stuve_parcel_line">Grau gestrichelt – Standard-Paketweg</string>
    <string name="help_stuve_active_parcel_line">Grün – Paketweg aus deinem Tippen oder einer Heizungsänderung</string>
    <string name="help_stuve_ccl_line">Braun gestrichelt – geschätzte Cumulus-Basis (CCL)</string>
    <string name="help_stuve_reference_grid">Die hellgrünen, türkisen und blauen Gitterlinien sind Trockenadiabaten, Feuchtadiabaten und Mischungsverhältnislinien. Der rechte Streifen markiert feuchte Schichten.</string>
    <string name="help_stuve_controls_title">Bedienelemente:</string>
    <string name="help_stuve_control_hour">Zeitschieberegler – Vorhersagestunde wechseln.</string>
    <string name="help_stuve_control_cursor">Tippe oder ziehe im Diagramm – lies Temperatur, Taupunkt, Paket, Wind, Druck und Höhe auf einer Ebene.</string>
    <string name="help_stuve_control_heating_zoom">Ziehe den grünen unteren Griff, um die Starttemperatur des Pakets zu ändern. Zum Zoomen der Höhe zwei Finger zusammenziehen.</string>

    <!-- Help dialog - Wind -->
    <string name="help_wind_title">Hilfe zur Windvorhersage</string>
    <string name="help_wind_summary">Die Farben der Windgeschwindigkeit reichen von blau über grün bis rot; rot markiert das Skalenmaximum (km/h):</string>
    <string name="help_wind_model_levels_info">Markierungen am rechten Rand zeigen Höhen mit direkten Winddaten des Modells. Werte dazwischen werden für die gewählte Stunde interpoliert.</string>
    <string name="help_wind_moisture_title">Feuchtigkeitshinweise:</string>
    <string name="help_wind_ccl_line">Orange CCL-Linie – geschätzte Cumulus-Basis bei ausreichender Erwärmung.</string>

    <!-- Help dialog - Cloud -->
    <string name="help_cloud_title">Hilfe zur Wolkenvorhersage</string>
    <string name="help_cloud_summary">Wolkenbedeckung und Sonnenenergie am Boden.</string>
    <string name="help_cloud_legend_sun">Sonnenstunden – direkte Sonneneinstrahlung, die den Boden erreicht.</string>
    <string name="help_cloud_legend_radiation">W/m² – Sonnenenergie am Boden; der wichtigste Thermikauslöser.</string>
    <string name="help_cloud_legend_layers" formatted="false">High / Mid / Low – Himmelsbedeckung nach Schicht, nicht Wolkendicke.</string>
    <string name="help_cloud_legend_rain" formatted="false">Rain – Wahrscheinlichkeit und Menge.</string>

