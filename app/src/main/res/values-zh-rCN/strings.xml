    <!-- Help dialog - Thermic -->
    <string name="help_thermic_title">热气流预报帮助</string>
    <string name="help_thermic_summary">颜色表示估算的空气上升速度（m/s），而非滑翔伞的净爬升。色阶从浅蓝经绿色到红色。</string>
    <string name="help_thermic_model_blocks_info">彩色方块为时间-高度分区；纯红色标记上升色阶的上边界。</string>
    <string name="help_thermic_cursor_info">点击单元格可查看时间、高度、升力范围、云层、置信度和模型诊断。</string>
    <string name="help_thermic_dashed_lines_title">线条、色带与诊断：</string>
    <string name="help_thermic_dry_top_line">橙色斜线 — 热气流顶部的不确定性</string>
    <string name="help_thermic_cloud_base_line">半透明蓝色区域 — 可能的云层，而非干升力</string>
    <string name="help_thermic_moist_top_line">紫色 — 湿润/云顶</string>
    <string name="help_thermic_pressure_levels_line">灰色虚线 — 原始气压层</string>

    <!-- Help dialog - Skew-T -->
    <string name="help_stuve_title">Skew-T log-P 图</string>
    <string name="help_stuve_summary">某一预报时刻的垂直探空。越往上海拔越高；气压向上递减。</string>
    <string name="help_stuve_lines_title">线条：</string>
    <string name="help_stuve_temperature_line">红色 — 气温</string>
    <string name="help_stuve_dewpoint_line">蓝色 — 露点</string>
    <string name="help_stuve_parcel_line">灰色虚线 — 默认气块路径</string>
    <string name="help_stuve_active_parcel_line">绿色 — 根据你的点击或加热变化得出的气块路径</string>
    <string name="help_stuve_ccl_line">棕色虚线 — 估算的积云底（CCL）</string>
    <string name="help_stuve_reference_grid">浅绿色、青色和蓝色网格线分别是干绝热线、湿绝热线和混合比线。右侧条带标记湿润层。</string>
    <string name="help_stuve_controls_title">操作：</string>
    <string name="help_stuve_control_hour">时间滑块 — 切换预报时刻。</string>
    <string name="help_stuve_control_cursor">点击或拖动图表 — 读取某一层的气温、露点、气块、风、气压和海拔。</string>
    <string name="help_stuve_control_heating_zoom">拖动底部绿色手柄可更改气块起始温度。双指捏合可缩放海拔。</string>

    <!-- Help dialog - Wind -->
    <string name="help_wind_title">风预报帮助</string>
    <string name="help_wind_summary">风速颜色从蓝色经绿色到红色；红色标记色阶最大值（km/h）：</string>
    <string name="help_wind_moisture_title">湿度提示：</string>
    <string name="help_wind_ccl_line">橙色 CCL 线 — 加热充足时估算的积云底。</string>

