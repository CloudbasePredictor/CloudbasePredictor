{
  "name": "cloudbase-predictor-web",
  "version": "0.0.0",
  "private": true,
  "description": "Web version of Cloudbase Predictor: thermic, wind, cloud and Stuve forecasts for soaring pilots.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
